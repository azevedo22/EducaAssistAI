# Copiar para .env e preencher. Nunca commitar o .env.

# LLM: "ollama" (local), "groq" (cloud) ou "gemini" (cloud)
LLM_PROVIDER=ollama

# Ollama (LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Groq (LLM_PROVIDER=groq) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini como LLM (LLM_PROVIDER=gemini) — https://aistudio.google.com/apikey
GEMINI_LLM_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash

# Embeddings: "local" (sentence-transformers) ou "gemini"
EMBED_PROVIDER=local

# Google (EMBED_PROVIDER=gemini; também usada como fallback da chave do LLM Gemini)
GOOGLE_API_KEY=
